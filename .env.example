# FeeFlow Environment Configuration Example
PORT=5000

# Local MySQL Configuration (e.g. XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=feeflow
DB_PORT=3306
DB_SSL=false

# Cloud MySQL (e.g., TiDB Cloud, Aiven, Clever Cloud, Railway)
# For Cloud DBs, you can set the above fields OR provide DATABASE_URL:
# DATABASE_URL=mysql://username:password@gateway.tidbcloud.com:4000/feeflow
# DB_SSL=true

# Security
JWT_SECRET=feeflow_secure_production_secret_key_change_me
